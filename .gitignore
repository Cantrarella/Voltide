# Build output
*.exe
*.pdb
obj/
dist/

# Fonts are embedded into the executable at build time and are not redistributed
# with the source (their licence). build.ps1 fails if MiSans-Medium.ttf or
# MiSans-Digits.ttf is missing, so a clean tree cannot silently ship without them.
Fonts/

